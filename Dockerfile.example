# syntax=docker/dockerfile:1
#
# Reference customer runner image. Copy into your integration package (or use as
# a starting point). Pin `@polycore/runner` in package.json; bake config +
# actions; bind project slug and GCP project from runtime env.

FROM node:22-slim
ENV NODE_ENV=production
WORKDIR /app

COPY package.json package-lock.json /app/
RUN npm ci --omit=dev

COPY polycore.json /app/integration/polycore.json
COPY context /app/integration/context
COPY actions /app/integration/actions

CMD ["node_modules/.bin/polycore-runner", "connect"]
